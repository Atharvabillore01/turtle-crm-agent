# Turtle CRM Agent Environment Configuration
# Copy this to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================================================
# LLM PROVIDER SELECTION
# ============================================================================
# Choose which LLM provider to use: anthropic, openai, azure, groq
LLM_PROVIDER=openai

# ============================================================================
# ANTHROPIC (Claude) CONFIGURATION
# ============================================================================
# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: specify Claude model (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================
# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
# Optional: specify OpenAI model (default: gpt-4.1)
OPENAI_MODEL=gpt-4.1

# ============================================================================
# AZURE OPENAI CONFIGURATION
# ============================================================================
# Required if LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# Optional: API version (default: 2024-12-01-preview)
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ============================================================================
# GROQ CONFIGURATION
# ============================================================================
# Required if LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# Optional: specify Groq model (default: mixtral-8x7b-32768)
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================================
# PROCESSING CONFIGURATION (defaults shown)
# ============================================================================
CONFIDENCE_THRESHOLD=0.70
LOG_LEVEL=INFO
OUTPUT_DIR=./output
DATA_DIR=./data/conversations
# Max characters of transcript sent to LLM per agent call (default: 60000, raise for larger context models)
MAX_TRANSCRIPT_CHARS=60000

# ============================================================================
# OPTIONAL: Directory Paths
# ============================================================================
# SCHEMA_PATH=./schema/crm_schema.json
# AUDIT_LOG_DIR=./logs/audit
# DEBUG_LOGS_DIR=./logs/debug
